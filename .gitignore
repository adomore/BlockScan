# Build output
/target

# Scan corpora — regenerated by running the tool
/out
/output
/beacon_smoke

# Secrets
.env

# Per-machine Claude Code settings (the shared `settings.json` stays tracked)
.claude/settings.local.json

# Release archives and prebuilt binaries — built by the `Release` workflow on a
# tag push, which also produces the SHA256SUMS that describes them. That manifest
# is a release asset only: a tracked copy cannot be written before the archives
# exist, so it would always describe the previous release. `release/RELEASE_NOTES.md`
# stays tracked (plain text).
*.tar.gz
*.tar.gz.sha256
*.zip
*.exe

# Scratch harnesses left behind by review subagents (never part of the suite)
/tests/zz_*.rs

# External audit package and the prompt that drives it. Inputs to the work, not
# products of this repo — and `reports/` alone is ~4.8 MB of PDFs. The tarball
# it arrives in is already covered by *.tar.gz above.
/blockscan-evolution/
/CLAUDE_CODE_PROMPT.md
